{
  "name": "studio-hq",
  "version": "2.0.0",
  "description": "Local-first producer workflow app",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite build && electron-vite preview",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --mac dir --arm64"
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "essentia.js": "^0.1.3",
    "ffmpeg-static": "^5.3.0",
    "music-metadata": "^12.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "productName": "Studio HQ",
  "private": true,
  "build": {
    "appId": "com.studiohq.app",
    "productName": "Studio HQ",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": false,
    "npmRebuild": true,
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "identity": null,
      "extendInfo": {
        "NSDesktopFolderUsageDescription": "Studio HQ reads your beat and sound folders.",
        "NSDocumentsFolderUsageDescription": "Studio HQ reads your FL Studio projects and saves exports and split sheets.",
        "NSDownloadsFolderUsageDescription": "Studio HQ can read files you choose from Downloads.",
        "NSAppleEventsUsageDescription": "Studio HQ asks Finder to move FL projects you choose to the Trash.",
        "NSRemovableVolumesUsageDescription": "Studio HQ reads sound folders on external drives."
      }
    }
  }
}
