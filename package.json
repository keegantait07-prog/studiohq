{
  "name": "studio-hq",
  "version": "2.0.0",
  "description": "Local-first producer workflow app",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite build && electron-vite preview",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --mac dir --arm64",
    "test": "vitest run"
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.10.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@number-flow/react": "^0.6.2",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@remotion/player": "4.0.539",
    "@tailwindcss/vite": "^4.3.5",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "essentia.js": "^0.1.3",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^14.14.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.73.0",
    "media-chrome": "^4.19.5",
    "mediabunny": "1.65.0",
    "motion": "^14.14.0",
    "music-metadata": "^12.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-intersection-observer": "^11.0.1",
    "remotion": "4.0.539",
    "swiper": "^14.4.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "use-sound": "^5.0.0"
  },
  "productName": "Studio HQ",
  "private": true,
  "build": {
    "appId": "com.studiohq.app",
    "productName": "Studio HQ",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": false,
    "npmRebuild": true,
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "identity": null,
      "extendInfo": {
        "NSDesktopFolderUsageDescription": "Studio HQ reads your beat and sound folders.",
        "NSDocumentsFolderUsageDescription": "Studio HQ reads your FL Studio projects and saves exports and split sheets.",
        "NSDownloadsFolderUsageDescription": "Studio HQ can read files you choose from Downloads.",
        "NSAppleEventsUsageDescription": "Studio HQ asks Finder to move FL projects you choose to the Trash.",
        "NSRemovableVolumesUsageDescription": "Studio HQ reads sound folders on external drives."
      }
    }
  }
}
