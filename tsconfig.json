{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true, "noEmit": true,
    "types": ["node", "electron-vite/node"],
    "paths": { "@shared/*": ["./src/shared/*"], "@/*": ["./src/renderer/src/*"] }
  },
  "include": ["src", "electron.vite.config.ts"],
  "exclude": [
    "src/renderer/src/components/lib/file-tree.tsx",
    "src/renderer/src/components/lib/skiper-ui/skiper26.tsx",
    "src/renderer/src/components/lib/skiper-ui/skiper40.tsx",
    "src/renderer/src/components/lib/skiper-ui/skiper64.tsx",
    "src/renderer/src/components/lib/skiper-ui/skiper101.tsx",
    "src/renderer/src/components/lib/skiper-ui/skiper106.tsx"
  ]
}
